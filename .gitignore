# Python / analysis artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Virtual environments
.venv/
.venvs/
venv/

# Raw third-party data and archives (never commit; acquisition-only).
# KNMI responses are CC BY 4.0 and the GFS byte ranges are open data, but the raw
# archives are not ours to redistribute and are regenerated by REPRODUCIBLE_RUNBOOK.md.
data/raw/
sources/raw/
sources/extracted/
*.zip
*.grib2
*.idx
*.pdf
*.docx

# Derived epoch tables: regenerable from the raw archives by one documented command, and
# large enough that keeping them in history would bloat the repository. The Zenodo
# deposit carries them instead.
outputs/epochs_*.csv

# Collector provenance manifests: they describe byte ranges into a third-party archive
# and are regenerated by re-running the collector.
outputs/gfs_gust_manifest*.jsonl
outputs/gfs_gust_failures*.jsonl
outputs/gfs_multihazard*.jsonl

# Submission and review material stays private until the paper is accepted.
submission/
rounds/
logs/
release/
submission_package_*/
outputs/independent_audit*/
outputs/independent_audit_2_*/
outputs/gates/.work/
manuscript/*.docx
manuscript/*.docx.superseded*
manuscript/archive/
*.superseded*
*.zip.sha256
AiC_Weather_Decision_review*
progress_checkpoint_*.md

# Superseded result versions: the three-station pilot and the pre-audit tables are kept
# locally for provenance but would mislead a reader who cloned the repository.
outputs/decision_epochs_*
outputs/g5_block_2cyc_*
outputs/g5_block_multi*
outputs/g5_lat*_campaign.json
outputs/epochs_multi.csv
outputs/epochs_multi2.csv
outputs/epochs_multi3_recheck.csv
outputs/multihazard_*
outputs/g5_multihazard_joint.json

# Generated logs and LaTeX build products
outputs/*.log
*.aux
*.log
*.out
*.fdb_latexmk
*.fls
*.xdv
*.synctex.gz
manuscript/qa/
code/_grib_scratch/
texput.log

# Credentials
.env
*.token
zenodo_token*

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*_Conflict*
